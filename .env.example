# The same Postgres database as the Student Diary (Neon's pooled URL in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# At least 32 characters. Must match the Student Diary and the Admin Panel.
SESSION_SECRET=""
# This app's own address: used for password reset links and the Secure cookie flag
APP_URL="http://localhost:3001"
# The Student Diary's address: links in notifications sent to students open there
STUDENT_APP_URL="http://localhost:3000"
# Vercel Blob store: the same private store as the Student Diary (read-only here)
BLOB_READ_WRITE_TOKEN=""
# Development only, without a Blob token: where the Student Diary saves uploads
UPLOADS_DIR="../courses_student/.uploads"
# Email through Resend. Leave empty in development: emails are written to ./.emails instead
RESEND_API_KEY=""
# Students get mail from this app too, so use a name that fits both
EMAIL_FROM="Your School <school@yourschool.az>"
# Web push: the same three values as the Student Diary, so phones keep receiving notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourschool.az"
# Shown in the privacy notice as the contact for data questions
PRIVACY_CONTACT_EMAIL=""
